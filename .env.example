# SHA backend settings
SHA_DATABASE_URL=sqlite:///data/sha.sqlite3
SHA_AUTH_MODE=development_open
SHA_DATABASE_MIGRATION_MODE=upgrade
# Optional file-mounted secret alternative for SHA_DATABASE_URL.
SHA_DATABASE_URL_FILE=
SHA_PORT=8010
# Optional: protect /api routes with Authorization: Bearer or X-SHA-API-Token.
SHA_API_TOKEN=
# Optional file-mounted secret alternative for SHA_API_TOKEN.
SHA_API_TOKEN_FILE=
# Optional: read-only API token for dashboards/auditors; cannot mutate state or download agent artifacts.
SHA_READONLY_API_TOKEN=
# Optional file-mounted secret alternative for SHA_READONLY_API_TOKEN.
SHA_READONLY_API_TOKEN_FILE=
# Required for installer artifacts whenever operator API or external-proxy auth is configured.
# In unauthenticated local mode, leaving this empty generates tokenless artifacts.
SHA_AGENT_API_TOKEN=
# Optional file-mounted secret alternative for SHA_AGENT_API_TOKEN.
SHA_AGENT_API_TOKEN_FILE=
# Optional: shared secret for a trusted SSO/identity proxy that sets X-SHA-External-Role.
SHA_EXTERNAL_AUTH_TRUSTED_TOKEN=
# Optional file-mounted secret alternative for SHA_EXTERNAL_AUTH_TRUSTED_TOKEN.
SHA_EXTERNAL_AUTH_TRUSTED_TOKEN_FILE=

# SHA frontend server settings for same-origin API proxying
API_URL=http://127.0.0.1:8010
# The frontend forwards only caller-bound authorization; it does not read or inject backend operator tokens.
# Explicit demo mode. Shows fixture-only data, labels every page, and disables mutations. Defaults off.
NEXT_PUBLIC_SHA_DEMO_MODE=false

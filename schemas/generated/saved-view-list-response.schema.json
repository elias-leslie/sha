        "saved_view_id": {
          "title": "Saved View Id",
          "type": "string"
        },
        "scope_type": {
          "$ref": "#/$defs/AuthorizationScopeType"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "visibility": {
          "$ref": "#/$defs/SavedViewVisibility"
        }
      },
      "required": [
        "saved_view_id",
        "name",
        "description",
        "visibility",
        "scope_type",
        "client_id",
        "location_id",
        "owner_user_id",
        "owner_actor",
        "current_version",
        "current_filter",
        "content_hash",
        "created_at",
        "updated_at"
      ],
      "title": "SavedViewResponse",
      "type": "object"
    },

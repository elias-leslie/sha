{
  "$defs": {
    "AgentProtocolCompatibility": {
      "additionalProperties": false,
      "properties": {
        "minimum_version": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$",
          "title": "Minimum Version",
          "type": "string"
        },
        "negotiated_version": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$",
          "title": "Negotiated Version",
          "type": "string"
        },
        "supported_versions": {
          "items": {
            "maxLength": 32,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Versions",
          "type": "array"
        }
      },
      "required": [
        "negotiated_version",
        "minimum_version",
        "supported_versions"
      ],
      "title": "AgentProtocolCompatibility",
      "type": "object"
    },
    "ConnectivityStatus": {
      "enum": [
        "online",
        "degraded"
      ],
      "title": "ConnectivityStatus",
      "type": "string"
    },
    "EndpointStatus": {
      "enum": [
        "pending",
        "active",
        "stale"
      ],
      "title": "EndpointStatus",
      "type": "string"
    }
  },
  "properties": {
    "accepted_capability_count": {
      "title": "Accepted Capability Count",
      "type": "integer"
    },
    "connectivity_status": {
      "$ref": "#/$defs/ConnectivityStatus"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "endpoint_id": {
      "title": "Endpoint Id",
      "type": "string"
    },
    "last_heartbeat_at": {
      "title": "Last Heartbeat At",
      "type": "string"
    },
    "last_seen_at": {
      "title": "Last Seen At",
      "type": "string"
    },
    "pending_action_count": {
      "title": "Pending Action Count",
      "type": "integer"
    },
    "protocol": {
      "$ref": "#/$defs/AgentProtocolCompatibility"
    },
    "status": {
      "$ref": "#/$defs/EndpointStatus"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "endpoint_id",
    "status",
    "connectivity_status",
    "last_seen_at",
    "last_heartbeat_at",
    "accepted_capability_count",
    "pending_action_count",
    "protocol",
    "created_at",
    "updated_at"
  ],
  "title": "EndpointHeartbeatAck",
  "type": "object"
}

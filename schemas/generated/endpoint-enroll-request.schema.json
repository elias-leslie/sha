{
  "$defs": {
    "EndpointPlatform": {
      "enum": [
        "windows",
        "linux",
        "macos"
      ],
      "title": "EndpointPlatform",
      "type": "string"
    }
  },
  "properties": {
    "agent_fingerprint": {
      "title": "Agent Fingerprint",
      "type": "string"
    },
    "agent_version": {
      "title": "Agent Version",
      "type": "string"
    },
    "architecture": {
      "anyOf": [
        {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Architecture"
    },
    "hostname": {
      "title": "Hostname",
      "type": "string"
    },
    "platform": {
      "$ref": "#/$defs/EndpointPlatform"
    },
    "platform_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Platform Version"
    },
    "protocol_version": {
      "default": "legacy-v1",
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$",
      "title": "Protocol Version",
      "type": "string"
    },
    "site_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Site Id"
    },
    "tenant_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tenant Id"
    }
  },
  "required": [
    "agent_fingerprint",
    "hostname",
    "platform",
    "agent_version"
  ],
  "title": "EndpointEnrollRequest",
  "type": "object"
}
